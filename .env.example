# Proveedor de lenguaje: anthropic | simulado. Si se omite: anthropic cuando hay ANTHROPIC_API_KEY, si no simulado.
LLM_PROVIDER=
# Clave del proveedor (solo backend; nunca en el repositorio, el front ni los logs).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=90000

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
RATE_LIMIT_POR_MINUTO=20

# Protección opcional del link público: si se define, el front pide esta clave (cabecera x-access-key).
ACCESS_KEY=
# false deshabilita el botón "Reiniciar datos" (POST /api/reset).
ALLOW_RESET=true
PORT=3000
